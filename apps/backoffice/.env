# Database (Local development connecting to Docker Postgres)
DATABASE_URL="postgresql://naiera:bandanaiera@localhost:8943/naiera_db?pgbouncer=true"
DIRECT_URL="postgresql://naiera:bandanaiera@localhost:8943/naiera_db"

# NextAuth
NEXTAUTH_SECRET="dev-secret-change-in-production"
NEXTAUTH_URL="http://100.116.51.61:8910"

# App Configuration
NEXT_PUBLIC_APP_URL="http://100.116.51.61:8910"
NEXT_PUBLIC_APP_NAME="Naiera Backoffice Dev"
NEXT_PUBLIC_CITY_NAME="Naiera"

# Email Service (Resend)
RESEND_API_KEY="replace-with-real-resend-key"
EMAIL_FROM="Naiera <onboarding@resend.dev>"

# MinIO Object Storage (Local development connecting to Docker MinIO)
# MinIO runs in Docker with exposed port 8900 (API) and 8901 (Console)
MINIO_ENDPOINT="localhost"
MINIO_PORT="8900"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_USE_SSL="false"
MINIO_BUCKET="naiera-uploads-dev"

# Landing App Integration
# Landing runs locally on port 8911
LANDING_URL="http://localhost:8911"
LANDING_REVALIDATE_SECRET="dev-secret-change-in-production"
REVALIDATE_SECRET="dev-secret-change-in-production"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=8937
REDIS_PASSWORD=
REDIS_ENABLED=true
