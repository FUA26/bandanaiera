generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  category        String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String     @default(cuid())
  permissionId String     @default(cuid())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Role {
  id                       String           @id @default(cuid())
  name                     String           @unique
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  permissions              RolePermission[]
  defaultForSystemSettings SystemSettings[] @relation("DefaultUserRole")
  users                    User[]
}

model User {
  id                   String               @id @default(cuid())
  name                 String?
  email                String               @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  roleId               String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  passwordResetToken   String?              @unique
  passwordResetExpires DateTime?
  bio                  String?
  avatarId             String?              @unique
  avatarUrl            String?
  accounts             Account[]
  createdAgencies      Agency[]             @relation("AgencyCreator")
  updatedAgencies      Agency[]             @relation("AgencyUpdater")
  agencyActivityLogs   AgencyActivityLog[]  @relation("AgencyActivityLogs")
  createdEvents        Event[]              @relation("EventCreator")
  updatedEvents        Event[]              @relation("EventUpdater")
  eventActivityLogs    EventActivityLog[]   @relation("EventActivityLogs")
  uploadedFiles        File[]
  createdNews          News[]               @relation("NewsCreator")
  updatedNews          News[]               @relation("NewsUpdater")
  newsActivityLogs     NewsActivityLog[]    @relation("NewsActivityLogs")
  permissionCache      PermissionCache?
  createdServices      Service[]            @relation("ServiceCreator")
  updatedServices      Service[]            @relation("ServiceUpdater")
  serviceActivityLogs  ServiceActivityLog[] @relation("ServiceActivityLogs")
  sessions             Session[]
  tourismActivityLogs  TourismActivityLog[] @relation("TourismActivityLogs")
  createdTourism       TourismDestination[] @relation("TourismCreator")
  updatedTourism       TourismDestination[] @relation("TourismUpdater")
  avatar               File?                @relation("UserAvatar", fields: [avatarId], references: [id])
  role                 Role                 @relation(fields: [roleId], references: [id])
}

model PermissionCache {
  id          String   @id @default(cuid())
  userId      String   @unique
  permissions String[]
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SystemSettings {
  id                           String   @id @default(cuid())
  allowRegistration            Boolean  @default(true)
  requireEmailVerification     Boolean  @default(true)
  defaultUserRoleId            String
  emailVerificationExpiryHours Int      @default(24)
  siteName                     String   @default("Naiera")
  siteDescription              String?
  minPasswordLength            Int      @default(8)
  requireStrongPassword        Boolean  @default(false)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  citizenName                  String?  @default("Warga")
  contactAddress               String?
  contactEmails                Json?
  contactPhones                Json?
  copyrightText                String?
  heroBackgroundId             String?  @unique
  siteLogoId                   String?  @unique
  siteSubtitle                 String?
  socialFacebook               String?
  socialInstagram              String?
  socialTwitter                String?
  socialYouTube                String?
  versionNumber                String?  @default("1.0.0")
  defaultUserRole              Role     @relation("DefaultUserRole", fields: [defaultUserRoleId], references: [id])
  heroBackground               File?    @relation("HeroBackground", fields: [heroBackgroundId], references: [id])
  siteLogo                     File?    @relation("SiteLogo", fields: [siteLogoId], references: [id])
}

model File {
  id                  String               @id @default(cuid())
  originalFilename    String
  storedFilename      String               @unique
  mimeType            String
  size                Int
  bucketName          String               @default("naiera-uploads")
  storagePath         String
  cdnUrl              String?
  uploadedById        String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  isPublic            Boolean              @default(false)
  referenceCount      Int                  @default(0)
  lastAccessedAt      DateTime             @default(now())
  expiresAt           DateTime?
  width               Int?
  height              Int?
  category            FileCategory         @default(OTHER)
  agencyLogos         Agency[]             @relation("AgencyLogo")
  eventsAsImage       Event[]              @relation("EventImage")
  uploadedBy          User                 @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  newsAsFeaturedImage News[]               @relation("NewsFeaturedImage")
  serviceImages       ServiceImage[]       @relation("ServiceImageFiles")
  heroBackgrounds     SystemSettings?      @relation("HeroBackground")
  siteLogos           SystemSettings?      @relation("SiteLogo")
  tourismAsImage      TourismDestination[] @relation("TourismImage")
  avatars             User?                @relation("UserAvatar")

  @@index([uploadedById])
  @@index([category])
  @@index([expiresAt])
  @@index([deletedAt])
}

model ServiceCategory {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  icon       String
  color      String
  bgColor    String
  showInMenu Boolean   @default(true)
  order      Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  services   Service[]

  @@index([showInMenu])
  @@index([order])
}

model Agency {
  id                     String                 @id @default(cuid())
  slug                   String                 @unique
  name                   String
  nickname               String
  description            String
  logoId                 String?
  category               AgencyCategory
  address                String?
  contactInfo            Json?
  operatingHours         String?
  location               Json?
  socialMedia            Json?
  status                 AgencyStatus           @default(ACTIVE)
  showInMenu             Boolean                @default(true)
  order                  Int                    @default(0)
  createdById            String
  updatedById            String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  createdBy              User                   @relation("AgencyCreator", fields: [createdById], references: [id])
  logo                   File?                  @relation("AgencyLogo", fields: [logoId], references: [id])
  updatedBy              User?                  @relation("AgencyUpdater", fields: [updatedById], references: [id])
  activityLogs           AgencyActivityLog[]
  servicesAsOwner        Service[]              @relation("ServiceAgencyOwner")
  serviceRelatedAgencies ServiceRelatedAgency[] @relation("AgencyRelatedServices")

  @@index([category])
  @@index([status])
  @@index([showInMenu])
  @@index([order])
  @@index([slug])
}

model Service {
  id                  String                 @id @default(cuid())
  slug                String                 @unique
  icon                String
  name                String
  description         String
  categoryId          String
  badge               String?
  stats               String?
  showInMenu          Boolean                @default(true)
  order               Int                    @default(0)
  isIntegrated        Boolean                @default(false)
  detailedDescription String?
  requirements        Json?
  process             Json?
  duration            String?
  cost                String?
  contactInfo         Json?
  faqs                Json?
  downloadForms       Json?
  relatedServices     Json?
  status              ServiceStatus          @default(DRAFT)
  createdById         String
  updatedById         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  agencyId            String?
  agency              Agency?                @relation("ServiceAgencyOwner", fields: [agencyId], references: [id])
  category            ServiceCategory        @relation(fields: [categoryId], references: [id])
  createdBy           User                   @relation("ServiceCreator", fields: [createdById], references: [id])
  updatedBy           User?                  @relation("ServiceUpdater", fields: [updatedById], references: [id])
  activityLogs        ServiceActivityLog[]
  serviceImages       ServiceImage[]         @relation("ServiceImages")
  relatedAgencies     ServiceRelatedAgency[] @relation("ServiceRelatedAgencies")

  @@index([categoryId])
  @@index([status])
  @@index([order])
  @@index([slug])
}

model ServiceActivityLog {
  id        String   @id @default(cuid())
  serviceId String
  userId    String
  action    String
  changes   Json?
  createdAt DateTime @default(now())
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user      User     @relation("ServiceActivityLogs", fields: [userId], references: [id])

  @@index([serviceId])
  @@index([userId])
  @@index([createdAt])
}

model AgencyActivityLog {
  id        String   @id @default(cuid())
  agencyId  String
  userId    String
  action    String
  changes   Json?
  createdAt DateTime @default(now())
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user      User     @relation("AgencyActivityLogs", fields: [userId], references: [id])

  @@index([agencyId])
  @@index([userId])
  @@index([createdAt])
}

model ServiceRelatedAgency {
  id        String   @id @default(cuid())
  serviceId String
  agencyId  String
  createdAt DateTime @default(now())
  agency    Agency   @relation("AgencyRelatedServices", fields: [agencyId], references: [id], onDelete: Cascade)
  service   Service  @relation("ServiceRelatedAgencies", fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, agencyId])
  @@index([serviceId])
  @@index([agencyId])
}

model ServiceImage {
  id        String           @id @default(cuid())
  serviceId String
  fileId    String
  type      ServiceImageType
  order     Int              @default(0)
  createdAt DateTime         @default(now())
  file      File             @relation("ServiceImageFiles", fields: [fileId], references: [id], onDelete: Cascade)
  service   Service          @relation("ServiceImages", fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, fileId])
  @@index([serviceId])
  @@index([fileId])
  @@index([type])
}

model NewsCategory {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  color      String   @default("primary")
  showInMenu Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  news       News[]

  @@index([showInMenu])
  @@index([order])
}

model News {
  id              String            @id @default(cuid())
  slug            String            @unique
  title           String
  excerpt         String
  content         String?
  categoryId      String
  featuredImageId String?
  featured        Boolean           @default(false)
  showInMenu      Boolean           @default(true)
  order           Int               @default(0)
  author          String?
  readTime        String?
  tags            Json?
  publishedAt     DateTime?
  status          NewsStatus        @default(DRAFT)
  createdById     String
  updatedById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  category        NewsCategory      @relation(fields: [categoryId], references: [id])
  createdBy       User              @relation("NewsCreator", fields: [createdById], references: [id])
  featuredImage   File?             @relation("NewsFeaturedImage", fields: [featuredImageId], references: [id])
  updatedBy       User?             @relation("NewsUpdater", fields: [updatedById], references: [id])
  activityLogs    NewsActivityLog[]

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([order])
  @@index([slug])
  @@index([publishedAt])
}

model NewsActivityLog {
  id        String   @id @default(cuid())
  newsId    String
  userId    String
  action    String
  changes   Json?
  createdAt DateTime @default(now())
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user      User     @relation("NewsActivityLogs", fields: [userId], references: [id])

  @@index([newsId])
  @@index([userId])
  @@index([createdAt])
}

model EventCategory {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  color      String   @default("primary")
  showInMenu Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  events     Event[]

  @@index([showInMenu])
  @@index([order])
}

model Event {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  title                String
  description          String?
  categoryId           String
  date                 DateTime           @db.Date
  time                 String?
  location             String?
  locationUrl          String?
  type                 EventType          @default(OFFLINE)
  imageId              String?
  organizer            String
  organizerContact     String?
  attendees            Json?
  registrationRequired Boolean            @default(false)
  registrationUrl      String?
  maxAttendees         Int?
  featured             Boolean            @default(false)
  showInMenu           Boolean            @default(true)
  order                Int                @default(0)
  status               EventStatus        @default(DRAFT)
  createdById          String
  updatedById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  category             EventCategory      @relation(fields: [categoryId], references: [id])
  createdBy            User               @relation("EventCreator", fields: [createdById], references: [id])
  image                File?              @relation("EventImage", fields: [imageId], references: [id])
  updatedBy            User?              @relation("EventUpdater", fields: [updatedById], references: [id])
  activityLogs         EventActivityLog[]

  @@index([categoryId])
  @@index([status])
  @@index([type])
  @@index([featured])
  @@index([date])
  @@index([order])
  @@index([slug])
}

model EventActivityLog {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  action    String
  changes   Json?
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation("EventActivityLogs", fields: [userId], references: [id])

  @@index([eventId])
  @@index([userId])
  @@index([createdAt])
}

model TourismCategory {
  id           String               @id @default(cuid())
  name         String
  slug         String               @unique
  color        String               @default("primary")
  showInMenu   Boolean              @default(true)
  order        Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  destinations TourismDestination[]

  @@index([showInMenu])
  @@index([order])
}

model TourismDestination {
  id           String               @id @default(cuid())
  slug         String               @unique
  name         String
  description  String
  content      String?
  categoryId   String
  location     String?
  locationUrl  String?
  price        String?
  openHours    String?
  facilities   Json?
  imageId      String?
  featured     Boolean              @default(false)
  showInMenu   Boolean              @default(true)
  order        Int                  @default(0)
  rating       Float                @default(0.0)
  reviews      Int                  @default(0)
  status       TourismStatus        @default(DRAFT)
  createdById  String
  updatedById  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  activityLogs TourismActivityLog[]
  category     TourismCategory      @relation(fields: [categoryId], references: [id])
  createdBy    User                 @relation("TourismCreator", fields: [createdById], references: [id])
  image        File?                @relation("TourismImage", fields: [imageId], references: [id])
  updatedBy    User?                @relation("TourismUpdater", fields: [updatedById], references: [id])

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([order])
  @@index([slug])
}

model TourismActivityLog {
  id            String             @id @default(cuid())
  destinationId String
  userId        String
  action        String
  changes       Json?
  createdAt     DateTime           @default(now())
  destination   TourismDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  user          User               @relation("TourismActivityLogs", fields: [userId], references: [id])

  @@index([destinationId])
  @@index([userId])
  @@index([createdAt])
}

enum FileCategory {
  IMAGE
  DOCUMENT
  VIDEO
  AUDIO
  OTHER
  AVATAR
  ARCHIVE
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EventType {
  ONLINE
  OFFLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum AgencyCategory {
  BADAN
  DINAS
  KECAMATAN
  DESA
}

enum AgencyStatus {
  ACTIVE
  INACTIVE
}

enum ServiceImageType {
  BANNER
  DOKUMEN
}

enum TourismStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
