# PostgreSQL
POSTGRES_USER=naiera
POSTGRES_PASSWORD=bandanaiera
POSTGRES_DB=naiera_db

# Redis (default no auth needed for development)

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=naiera-uploads-dev

# Connection URLs (untuk aplikasi)
DATABASE_URL="postgresql://naiera:bandanaiera@localhost:8943/naiera_db?pgbouncer=true"
DIRECT_URL="postgresql://naiera:bandanaiera@localhost:8943/naiera_db"
REDIS_URL="redis://localhost:8937"
MINIO_ENDPOINT="localhost"
MINIO_PORT="8900"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_USE_SSL="false"
